    "animejs": "^4.1.3",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "postprocessing": "^6.37.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/animejs": "^3.1.13",
    "@types/node": "^22.15.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
